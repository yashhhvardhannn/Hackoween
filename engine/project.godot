config_version=5

[application]
config/name="Membrane Robot Simulator"
run/main_scene="res://scenes/world.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[physics]
3d/default_gravity=9.8

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.75, 0.85, 0.95, 1)

[autoload]

ApiServer="*res://scripts/api/api_server.gd"
StateMachine="*res://scripts/api/state_machine.gd"

